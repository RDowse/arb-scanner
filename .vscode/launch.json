{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Detector",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/detector",
            "env": {
                "DATABASE_URL": "postgres://arb:arb@localhost:5432/arb?sslmode=disable",
                "ARB_CONFIG": "${workspaceFolder}/config/strategies.yaml",
                "LOG_LEVEL": "debug"
            }
        },
        {
            "name": "API server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/api-server",
            "env": {
                "DATABASE_URL": "postgres://arb:arb@localhost:5432/arb?sslmode=disable",
                "HTTP_ADDR": ":8080",
                "MAX_FEED_AGE": "30s",
                "LOG_LEVEL": "debug"
            }
        },
        {
            "name": "Coinbase live feed (test)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/venue",
            "buildFlags": "-tags=live",
            "args": ["-test.run", "TestCoinbaseLive", "-test.v"],
            "env": {
                "LIVE_DURATION": "60s"
            }
        }
    ],
    "compounds": [
        {
            "name": "Detector + API server",
            "configurations": ["Detector", "API server"]
        }
    ]
}
